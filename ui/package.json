{
  "name": "wafflery-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit && tsc --project ../scripts/tsconfig.json",
    "build": "vite build",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --ci --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "test:unit": "bun test tests/unit",
    "test:browser": "bun ../scripts/build-ui.ts && cargo build --manifest-path ../Cargo.toml --locked --bin wafflery --example sample-lab && playwright test",
    "preview": "vite preview --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "storybook": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "22.19.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
